{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_sources}",
    "issues": "${mod_issues}"
  },
  "license": "GPL-3.0-only",
  "icon": "assets/pocket_gallery/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.pocketgallery.fabric.PocketGalleryFabric"]
  },
  "mixins": [
    {"config": "pocket_gallery.mixins.json", "environment": "client"},
    {"config": "pocket_gallery.fabric.mixins.json", "environment": "client"}
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "${fabric_minecraft_range}",
    "java": ">=25",
    "fabric-api": "*",
    "immersive_paintings": ">=${immersive_paintings_version}"
  }
}
